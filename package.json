{
  "name": "mcp-notes",
  "version": "1.0.0",
  "description": "An MCP server for capturing and querying project notes. A complete, minimal reference implementation of tools, resources and prompts.",
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "bin": {
    "mcp-notes": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector npx tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "mongoose": "^9.11.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "license": "MIT"
}
